---
/**
 * Every Markdown file in src/content/pages/ becomes a page at its file name:
 * about.md → /about/, legal/terms.md → /legal/terms/.
 *
 * Optional frontmatter adds a call-to-action band (`cta:`) and alternating
 * image + text sections (`rows:`) above the Markdown body; see
 * README.md ("Adding and editing content"). A page that needs a layout of its own gets its own
 * .astro file in src/pages/ instead (like index.astro); add its id to
 * BESPOKE below if a Markdown file with the same name also exists.
 */
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageBanner from '../components/PageBanner.astro';
import CtaBand from '../components/CtaBand.astro';
import FeatureRow from '../components/FeatureRow.astro';

export async function getStaticPaths() {
	const BESPOKE: string[] = [];
	const pages = await getCollection('pages');
	return pages.filter((page) => !BESPOKE.includes(page.id)).map((page) => ({ params: { slug: page.id }, props: { page } }));
}

const { page } = Astro.props;
const { Content } = await render(page);
const rows = page.data.rows ?? [];
// With rows carrying the copy, the Markdown body is optional: only render
// the prose column when there's something in it.
const hasBody = (page.body?.trim().length ?? 0) > 0;
---

<BaseLayout title={page.data.title} description={page.data.description} image={page.data.shareImage}>
	<PageBanner title={page.data.title} />
	{page.data.cta && <CtaBand {...page.data.cta} />}
	{rows.map((row, i) => <FeatureRow {...row} reverse={row.reverse ?? i % 2 === 1} variant={row.variant ?? (i % 2 === 1 ? 'alt' : 'default')} />)}
	{
		hasBody && (
			<article class="wrap prose page-body">
				<Content />
			</article>
		)
	}
</BaseLayout>

<style>
	.page-body {
		max-width: 48rem;
		padding-top: 2.5rem;
		padding-bottom: 4rem;
	}
</style>
