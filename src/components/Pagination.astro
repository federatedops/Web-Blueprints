---
/**
 * Back / 1 … 4 5 6 … 12 / Next. Works with the Page object Astro's
 * paginate() gives a page (only currentPage and lastPage are read).
 */
interface Props {
	page: { currentPage: number; lastPage: number };
	/** Base-prefixed URL of page 1, ending in a slash, e.g. withBase('/news/').
	 *  Page n is `${basePath}${n}/`. */
	basePath: string;
}

const { page, basePath } = Astro.props;
const { currentPage, lastPage } = page;

const pageUrl = (n: number) => (n === 1 ? basePath : `${basePath}${n}/`);

// Always the first, last and current page and the current page's
// neighbors; everything else collapses into an ellipsis.
function pageTokens(current: number, last: number): (number | 'gap')[] {
	const keep = [...new Set([1, last, current, current - 1, current + 1])].filter((p) => p >= 1 && p <= last).sort((a, b) => a - b);
	const tokens: (number | 'gap')[] = [];
	keep.forEach((p, i) => {
		if (i > 0 && p - keep[i - 1] > 1) tokens.push('gap');
		tokens.push(p);
	});
	return tokens;
}
---

{
	lastPage > 1 && (
		<nav class="pagination" aria-label="Pagination">
			{currentPage > 1 ? (
				<a class="btn" href={pageUrl(currentPage - 1)} rel="prev">
					← Back
				</a>
			) : (
				<span class="btn is-disabled" aria-disabled="true">
					← Back
				</span>
			)}
			<ul>
				{pageTokens(currentPage, lastPage).map((t) =>
					t === 'gap' ? (
						<li aria-hidden="true">…</li>
					) : (
						<li>
							<a href={pageUrl(t)} class:list={['pagination-page', { 'is-active': t === currentPage }]} aria-current={t === currentPage ? 'page' : undefined}>
								{t}
							</a>
						</li>
					),
				)}
			</ul>
			{currentPage < lastPage ? (
				<a class="btn" href={pageUrl(currentPage + 1)} rel="next">
					Next →
				</a>
			) : (
				<span class="btn is-disabled" aria-disabled="true">
					Next →
				</span>
			)}
		</nav>
	)
}

<style>
	.pagination {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 1rem;
		margin-top: 2.5rem;
	}

	ul {
		display: flex;
		align-items: center;
		gap: 0.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
		color: var(--color-text-muted);
	}

	.pagination-page {
		display: inline-grid;
		place-items: center;
		min-width: 2.25rem;
		height: 2.25rem;
		border-radius: 0.5rem;
		color: var(--color-text);
		font-weight: 600;
		text-decoration: none;
	}

	.pagination-page:hover {
		background: var(--color-bg-alt);
	}

	.pagination-page.is-active {
		background: var(--color-primary);
		color: #fff;
	}

	.btn.is-disabled {
		opacity: 0.45;
		cursor: not-allowed;
	}
</style>
