---
import { categoryCounts, categoryLabel, categoryUrl, type Post } from '../utils/news';
import { withBase } from '../utils/base';

interface Props {
	posts: Post[];
	/** The category being shown, or undefined on the all-news page. */
	active?: string;
}

const { posts, active } = Astro.props;
const categories = categoryCounts(posts);
---

<nav class="category-chips" aria-label="News categories">
	<a href={withBase('/news/')} class:list={['chip', { 'is-active': !active }]} aria-current={!active ? 'page' : undefined}>All</a>
	{
		categories.map(({ category, count }) => (
			<a href={categoryUrl(category)} class:list={['chip', { 'is-active': active === category }]} aria-current={active === category ? 'page' : undefined}>
				{categoryLabel(category)} <span class="category-chips-count">{count}</span>
			</a>
		))
	}
</nav>

<style>
	.category-chips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-bottom: 1.75rem;
	}

	.category-chips-count {
		font-weight: 400;
		opacity: 0.7;
	}
</style>
