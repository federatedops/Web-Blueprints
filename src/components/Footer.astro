---
import { site } from '../data/site';
import { primaryNav, legalNav, socialLinks, socialIcons, type NavLink } from '../data/nav';
import { withBase } from '../utils/base';

// One column per top-level menu item: the item itself, then its children.
const columns = primaryNav.filter((item) => item.href !== '/');
const href = (link: NavLink) => (link.external ? link.href : withBase(link.href));
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="wrap site-footer-grid">
		<div class="site-footer-brand">
			<a href={withBase('/')} class="brand">
				<span class="brand-mark" aria-hidden="true"></span>
				<span class="brand-text">
					<span class="brand-name">{site.name}</span>
					<span class="brand-tagline">{site.tagline}</span>
				</span>
			</a>
			<ul class="social-list">
				{
					socialLinks.map((link) => (
						<li>
							<a href={link.href} target="_blank" rel="noopener" aria-label={link.label}>
								<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
									<path d={socialIcons[link.label]} />
								</svg>
							</a>
						</li>
					))
				}
			</ul>
		</div>

		<nav class="site-footer-links" aria-label="Footer">
			{
				columns.map((item) => (
					<div>
						<h2>
							<a href={href(item)}>{item.label}</a>
						</h2>
						{item.children && (
							<ul>
								{item.children.map((child) => (
									<li>
										<a href={href(child)} target={child.external ? '_blank' : undefined} rel={child.external ? 'noopener' : undefined}>
											{child.label}
										</a>
									</li>
								))}
							</ul>
						)}
					</div>
				))
			}
		</nav>
	</div>

	<div class="site-footer-legal">
		<div class="wrap">
			<p>© {year} {site.name}</p>
			<ul>
				{
					legalNav.map((link) => (
						<li>
							<a href={href(link)}>{link.label}</a>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		margin-top: 0;
		background: var(--color-bg-alt);
		border-top: 1px solid var(--color-border);
	}

	.site-footer-grid {
		display: grid;
		grid-template-columns: minmax(14rem, 1fr) 2fr;
		gap: 2rem;
		padding-top: 3rem;
		padding-bottom: 2.5rem;
	}

	.site-footer-brand {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.site-footer-links {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
		gap: 1.5rem;
	}

	h2 {
		margin: 0 0 0.6rem;
		font-size: 1rem;
	}

	h2 a {
		color: var(--color-heading);
		text-decoration: none;
	}

	ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	li + li {
		margin-top: 0.35rem;
	}

	.site-footer-links a:not(h2 a) {
		color: var(--color-text);
		text-decoration: none;
		font-size: 0.95rem;
	}

	.site-footer-links a:hover {
		color: var(--color-accent-dark);
	}

	.site-footer-legal {
		border-top: 1px solid var(--color-border);
		font-size: 0.85rem;
		color: var(--color-text-muted);
	}

	.site-footer-legal .wrap {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.5rem 1.5rem;
		padding-top: 1rem;
		padding-bottom: 1rem;
	}

	.site-footer-legal p {
		margin: 0;
	}

	.site-footer-legal ul {
		display: flex;
		gap: 1.25rem;
	}

	.site-footer-legal li + li {
		margin-top: 0;
	}

	.site-footer-legal a {
		color: inherit;
	}

	@media (max-width: 48em) {
		.site-footer-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
